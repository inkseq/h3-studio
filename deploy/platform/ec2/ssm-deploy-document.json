{
  "schemaVersion": "2.2",
  "description": "Inkseq: only execute root-installed deployment of an independently approved commit; no arbitrary shell",
  "parameters": {
    "Commit": {
      "type": "String",
      "description": "Exact 40-hex commit with an independent root-owned manifest approval already present",
      "allowedPattern": "^[0-9a-f]{40}$",
      "interpolationType": "ENV_VAR"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "deployApprovedCommit",
      "precondition": {"StringEquals": ["platformType", "Linux"]},
      "inputs": {
        "timeoutSeconds": "1800",
        "runCommand": [
          "set -eu",
          "test -n \"${SSM_Commit:-}\"",
          "exec /usr/bin/python3 /opt/sixnine-release-origin-v1/deploy_approved.py \"$SSM_Commit\""
        ]
      }
    }
  ]
}
