# Non-secret references only. Use reviewed immutable images; no latest tags.
# These placeholders intentionally do not name a runnable release.
# New hosts require a matching root-owned deployment-target.json. This is a
# closed identity, not an arbitrary origin/secret-prefix override.
INKSEQ_DEPLOYMENT_TARGET=production
SIXNINE_IMAGE=sixnine-platform:REPLACE_WITH_TESTED_40_HEX_COMMIT
SIXNINE_POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_APPROVED_POSTGRES_17_DIGEST
SIXNINE_CADDY_IMAGE=caddy@sha256:REPLACE_WITH_APPROVED_CADDY_DIGEST
SIXNINE_DB_ADMIN_SECRET_FILE=/run/sixnine-secrets/db_admin_password
SIXNINE_APP_DSN_SECRET_FILE=/run/sixnine-secrets/app_database_url
# Phase A (0) serves new apex + old www; phase B (1) redirects old domains.
# Change only after new-domain TLS/login/PAT/Agent acceptance and retain the
# previous site.env together with the previous release for paired rollback.
INKSEQ_LEGACY_REDIRECT=0
