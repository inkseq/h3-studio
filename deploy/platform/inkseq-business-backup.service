[Unit]
Description=Inkseq private business snapshot and conditional off-device copy
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
# Recovery window: preserve every local snapshot; retention is a separate action.
ExecStart=/usr/bin/python3 -B /opt/inkseq-business-backup-v1/business_backup.py --daily-preserve
WorkingDirectory=/opt/inkseq-business-backup-v1
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8
UnsetEnvironment=PYTHONPATH PYTHONHOME AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE AWS_DEFAULT_PROFILE AWS_ENDPOINT_URL
UMask=0077
# 40m snapshot + 15m handoff + 30m transfer + 10m bounded validation headroom.
TimeoutStartSec=7200
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/inkseq-business-backup /srv/sixnine/release.lock /srv/sixnine/platform-data/business-backups

[Install]
WantedBy=multi-user.target
