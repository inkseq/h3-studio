{
    admin off
    servers {
        timeouts {
            read_header 10s
            read_body 15m
            idle 2m
        }
    }
}

staging.inkseq.com {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
        X-Inkseq-Environment staging
        -Server
    }
    request_body {
        max_size 537919488
    }
    reverse_proxy app:8845 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        transport http {
            dial_timeout 5s
            response_header_timeout 15m
        }
    }
    # No access logs, production hostnames, aliases or redirect blocks.
}
