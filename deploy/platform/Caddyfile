{
    admin off
    servers {
        timeouts {
            read_header 10s
            read_body 10m
            write 15m
            idle 2m
        }
    }
}

inkseq.com, www.sixnine.art {
    # Phase A serves the old www and new apex. Switch only after new TLS/login
    # acceptance; the host-side validator permits exactly 0 or 1.
    @retired_www {
        host www.sixnine.art
        expression `"{$INKSEQ_LEGACY_REDIRECT:0}" == "1"`
    }
    redir @retired_www https://inkseq.com{uri} 308
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options DENY
        Content-Security-Policy "frame-ancestors 'none'"
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.r2.cloudflarestorage.com; media-src 'self' data: blob: https://*.r2.cloudflarestorage.com; connect-src 'self' https://*.r2.cloudflarestorage.com https://us.i.posthog.com https://us-assets.i.posthog.com https://*.ingest.us.sentry.io; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        -Server
    }
    # 512 MiB file + 1 MiB multipart envelope; app checks actual receive bytes.
    request_body {
        max_size 537919488
    }
    # Dial-out GPU worker tunnels (#859): chisel server in the app namespace.
    handle /v1/worker-tunnel {
        reverse_proxy app:8846
    }
    reverse_proxy app:8845 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        transport http {
            dial_timeout 5s
            response_header_timeout 15m
        }
    }
    # Access logs are deliberately not enabled: cookies, signed Location URLs,
    # prompts and media parameters must not become request logs.
}

sixnine.art {
    @retired_apex expression `"{$INKSEQ_LEGACY_REDIRECT:0}" == "1"`
    redir @retired_apex https://inkseq.com{uri} 308
    redir https://www.sixnine.art{uri} 308
}

www.inkseq.com {
    redir https://inkseq.com{uri} 308
}

h3.sixnine.art {
    # A UI redirect only; this hostname does not proxy API requests to H3/GPU.
    @retired_h3 expression `"{$INKSEQ_LEGACY_REDIRECT:0}" == "1"`
    redir @retired_h3 https://inkseq.com/freestyle 308
    redir https://www.sixnine.art/freestyle 308
}
