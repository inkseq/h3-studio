{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Runtime pins only (upstream commits and image digests). Dependabot keeps Python packages and GitHub Actions. Runtime updates are never automerged: they need a frame-checked staging acceptance (docs/EXPERIMENTS.md).",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "Australia/Sydney",
  "schedule": ["before 9am on monday"],
  "enabledManagers": ["dockerfile", "custom.regex"],
  "automerge": false,
  "labels": ["dependencies", "runtime"],
  "prConcurrentLimit": 4,
  "customManagers": [
    {
      "customType": "regex",
      "description": "WanGP upstream revision (generation runtime)",
      "managerFilePatterns": ["/^deploy/dstack/Dockerfile\\.wangp-v9$/"],
      "matchStrings": ["ARG WANGP_REVISION=(?<currentDigest>[0-9a-f]{40})"],
      "depNameTemplate": "Wan2GP",
      "packageNameTemplate": "https://github.com/deepbeepmeep/Wan2GP",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "ComfyUI and custom nodes (enhance runtime)",
      "managerFilePatterns": ["/^deploy/enhance/Dockerfile$/"],
      "matchStrings": [
        "ARG COMFY_COMMIT=(?<currentDigest>[0-9a-f]{7,40})",
        "ARG REGENERATE_COMMIT=(?<currentDigest>[0-9a-f]{7,40})",
        "ARG UPSCALER_COMMIT=(?<currentDigest>[0-9a-f]{7,40})"
      ],
      "depNameTemplate": "{{#if (containsString matchString 'COMFY_')}}ComfyUI{{else if (containsString matchString 'REGENERATE_')}}ComfyUI-Open-H3-Regenerate{{else}}Comfyui_Minimax_h3_latent_Upscaler{{/if}}",
      "packageNameTemplate": "{{#if (containsString matchString 'COMFY_')}}https://github.com/comfyanonymous/ComfyUI{{else if (containsString matchString 'REGENERATE_')}}https://github.com/rdh9616/ComfyUI-Open-H3-Regenerate{{else}}https://github.com/LBH-123-AI/Comfyui_Minimax_h3_latent_Upscaler{{/if}}",
      "currentValueTemplate": "{{#if (containsString matchString 'COMFY_')}}master{{else}}main{{/if}}",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Generation/enhance runtimes: one weekly PR each, acceptance before merge",
      "matchDepNames": ["Wan2GP"],
      "groupName": "WanGP runtime"
    },
    {
      "matchDepNames": [
        "ComfyUI",
        "ComfyUI-Open-H3-Regenerate",
        "Comfyui_Minimax_h3_latent_Upscaler"
      ],
      "groupName": "Enhance runtime"
    },
    {
      "description": "Our own built runtime images are rebuilt by us, never bumped by digest",
      "matchPackageNames": ["public.ecr.aws/z9c3p9w6/sixnine/wangp"],
      "enabled": false
    },
    {
      "description": "dstack control plane",
      "matchPackageNames": ["dstackai/dstack"],
      "groupName": "dstack server"
    }
  ]
}
