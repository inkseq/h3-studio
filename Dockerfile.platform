# Reproducible source-only Inkseq web frontend; no local drafts or media enter this stage.
FROM node:22.23.4-alpine@sha256:ce8d97f7cfc7c5386421eb932df20a29df99b1a7f469f6157d5c9956702ffadc AS frontend
COPY deploy/tls/check_node_trust.mjs /build/check_node_trust.mjs
RUN node /build/check_node_trust.mjs
WORKDIR /build/inkseq-web
COPY inkseq-web/package.json inkseq-web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY inkseq-web/ ./
# CI runs the frontend test suite independently. Local/full image builds still
# compile from the verified source snapshot and serve assets at the site root.
RUN npm run build -- --base / --outDir /build/output

FROM python:3.12-slim-bookworm AS runtime-base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SIXNINE_FRONTEND_DIR=/app/yingxu-dist
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates=20250419~deb12u2 ffmpeg fontconfig fonts-noto-cjk=1:20220127+repack1-1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 sixnine \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin sixnine
WORKDIR /app
COPY requirements.lock.txt ./requirements.lock.txt
COPY deploy/tls/check_trust.py /opt/inkseq/tls/check_trust.py
RUN python -m pip install --no-cache-dir -r requirements.lock.txt \
    && python /opt/inkseq/tls/check_trust.py
# Distribution font package includes its OFL license in /usr/share/doc. No
# Windows system font or user-uploaded font is copied into the runtime image.
RUN test -f /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc \
    && fc-match --format='%{family}\n' 'Noto Sans CJK SC'

FROM runtime-base AS runtime
ENV XDG_CACHE_HOME=/tmp/sixnine-font-cache
COPY platform_app.py comfy_workflow.py comfy-object-info.json ./
COPY studio_platform/ ./studio_platform/
# Immutable public recipe/evidence metadata used by API and CPU workers.
# Protected execution policies and provider configuration remain runtime mounts.
COPY deploy/wangp/profiles/ ./deploy/wangp/profiles/
COPY skills/inkseq/ ./skills/inkseq/
COPY --from=frontend /build/output/ ./yingxu-dist/
USER 10001:10001
# Public proxy is the only published service. This port stays on the app network.
CMD ["python", "-m", "uvicorn", "platform_app:app", "--host", "0.0.0.0", "--port", "8845", "--workers", "1", "--no-access-log", "--no-proxy-headers"]
