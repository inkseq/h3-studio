# Send only the application source and pinned dependencies to Docker.
**
!Dockerfile
!.dockerignore
!requirements.lock.txt
!server.py
!password_auth.py
!comfy_workflow.py
!comfy-object-info.json
!tools/
!tools/manage_users.py
!web/
!web/index.html
!web/app.js
!web/styles.css
!web/h3-ref-bf16-workflow.json

# Separate v1 image inputs. No runtime directories or central vault are included.
!Dockerfile.platform
!platform_app.py
!studio_platform/
!studio_platform/*.py
!studio_platform/inference/
!studio_platform/inference/*.py
!studio_platform/runtime_hosts/
!studio_platform/runtime_hosts/*.py
!deploy/
deploy/*
!deploy/wangp/
deploy/wangp/*
!deploy/wangp/profiles/
deploy/wangp/profiles/*
!deploy/wangp/profiles/h3-pruned-rank8-int8-quanto-int8-vae-int8-sdpa-p4-lowram-v1.json
!deploy/wangp/profiles/h3-unpruned33b-int8-qwenbf16-vaefp16-sdpa-p3-lowram-v1.json
!deploy/wangp/profiles/h3-unpruned33b-bf16-qwenbf16-vaefp16-sdpa-p3-splitqkv-v2.json
!deploy/wangp/profiles/h3-pruned-rank8-int8-pro6000-quanto-int8-vae-int8-sdpa-p4-lowram-v1.json
!deploy/wangp/profiles/h3-pruned-rank8-int8-quanto-int8-vae-int8-sdpa-p4-29gib-v2.json
!deploy/wangp/profiles/h3-pruned-rank8-int8-quanto-int8-vae-int8-sdpa-p4-29gib-total-v3.json
!deploy/wangp/profiles/h3-pruned-rank8-int8-quanto-int8-vae-int8-sdpa-p4-29gib-cgroups-v4.json
!deploy/wangp/profiles/h3-unpruned33b-int8-qwenbf16-vaefp16-sdpa-p3-144gib-single-fl-v2.json
!deploy/wangp/profiles/h3-pruned-rank8-int8-sdpa-p4-29gib-fl-r2-v5.json
!deploy/wangp/profiles/h3-unpruned33b-int8-qwenbf16-vaefp16-sdpa-p3-144gib-fl-r2-v3.json
!yingxu/
!yingxu/package.json
!yingxu/package-lock.json
!yingxu/index.html
!yingxu/vite.config.js
!yingxu/source-manifest.json
!yingxu/src/
!yingxu/src/*.js
!yingxu/src/*.jsx
!yingxu/src/*.css
!yingxu/src/*.json
!skills/
!skills/sixnine-yingxu/
!skills/sixnine-yingxu/SKILL.md
!skills/sixnine-yingxu/scripts/
!skills/sixnine-yingxu/scripts/sixnine.py
!skills/sixnine-yingxu/scripts/connect.py

# CPU dispatch/telemetry only; never send protected config or provider tokens.
!Dockerfile.dispatch
!requirements.dispatch.lock.txt
!requirements.hatchet.txt
!deploy/observability/
!deploy/observability/requirements.lock.txt
!deploy/dstack/
!deploy/dstack/Dockerfile.wangp
!deploy/dstack/repair_decord_metadata.py
!deploy/wangp/bootstrap.py
