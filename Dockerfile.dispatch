# Existing platform image and schema; PostgreSQL workers add CPU telemetry dependencies.
ARG PLATFORM_IMAGE
FROM ${PLATFORM_IMAGE}
ARG PLATFORM_IMAGE
USER root
# CI already supplies inkseq-platform:<exact release SHA>. Preserve that
# nonsecret identity in the immutable CPU image; no Docker socket is needed.
RUN printf '%s\n' "$PLATFORM_IMAGE" > /app/inkseq-controller-image
COPY requirements.dispatch.lock.txt /app/requirements.dispatch.lock.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /app/requirements.dispatch.lock.txt \
    && python -m pip check \
    && python /opt/inkseq/tls/check_trust.py
# Pinned chisel (MIT, github.com/jpillora/chisel v1.12.0) for dial-out GPU worker
# tunnels (#859). tools/fetch_chisel.py holds the pin and checks the sha256
# before anything is installed. CI restores the release asset from its actions
# cache into .build-cache/ (#1151); without it the release is downloaded with
# retry. The lock file is listed so the COPY succeeds when .build-cache is absent.
COPY tools/fetch_chisel.py requirements.dispatch.lock.txt .build-cache* /tmp/chisel-build/
RUN python /tmp/chisel-build/fetch_chisel.py --cache /tmp/chisel-build --install /usr/local/bin/chisel \
    && rm -rf /tmp/chisel-build \
    && /usr/local/bin/chisel --version
USER 10001:10001
# A protected compose sets the exact controller or per-slot worker role.
CMD ["python", "-m", "studio_platform.postgres_dispatch", "--help"]
