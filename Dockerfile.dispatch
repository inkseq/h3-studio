# Existing platform image and schema; PostgreSQL workers add CPU telemetry dependencies.
ARG PLATFORM_IMAGE
FROM ${PLATFORM_IMAGE}
ARG PLATFORM_IMAGE
USER root
# CI already supplies inkseq-platform:<exact release SHA>. Preserve that
# nonsecret identity in the immutable CPU image; no Docker socket is needed.
RUN printf '%s\n' "$PLATFORM_IMAGE" > /app/inkseq-controller-image
COPY requirements.dispatch.lock.txt /app/requirements.dispatch.lock.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /app/requirements.dispatch.lock.txt \
    && python -m pip check \
    && python /opt/inkseq/tls/check_trust.py
# Pinned chisel (MIT, github.com/jpillora/chisel v1.12.0) for dial-out GPU worker
# tunnels (#859). The release checksum is verified before anything is installed.
ARG CHISEL_SHA256=f3f180f1d93aa72cce4e6386f98cc06569a0146fbd65eb4423cf83e6434bcfe6
# GitHub release downloads return 504 at times (#1151): retry with backoff.
RUN python -c "exec(\"import gzip,hashlib,os,sys,time,urllib.request\nurl='https://github.com/jpillora/chisel/releases/download/v1.12.0/chisel_1.12.0_linux_amd64.gz'\nfor attempt in range(6):\n try:\n  data=urllib.request.urlopen(url,timeout=120).read(); break\n except OSError:\n  if attempt==5: raise\n  time.sleep(5*2**attempt)\nsys.exit('chisel_checksum_mismatch') if hashlib.sha256(data).hexdigest()!=os.environ['CHISEL_SHA256'] else None\nopen('/usr/local/bin/chisel','wb').write(gzip.decompress(data)); os.chmod('/usr/local/bin/chisel',0o755)\")"     && /usr/local/bin/chisel --version
USER 10001:10001
# A protected compose sets the exact controller or per-slot worker role.
CMD ["python", "-m", "studio_platform.postgres_dispatch", "--help"]
